# Copy to .env and fill in locally. Never commit real credentials (.env is git-ignored).

# Anthropic API key (https://console.anthropic.com). ANTHROPIC_API_KEY also works.
LLM_API_KEY=
# Model id; default claude-opus-5-5. A cheaper option for development: claude-haiku-5-5
LLM_MODEL=claude-haiku-5-5
# Optional tuning
LLM_EFFORT=medium
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
